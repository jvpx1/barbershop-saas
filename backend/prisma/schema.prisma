// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  BARBER
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  DONE
}

model Barbershop {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String   @default("#111827")
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  timezone     String   @default("America/Manaus")

  users        User[]
  barbers      Barber[]
  services     Service[]
  appointments Appointment[]

  @@map("barbershops")
}

model User {
  id           Int      @id @default(autoincrement())
  barbershopId Int
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@map("users")
}

model Barber {
  id           Int     @id @default(autoincrement())
  barbershopId Int
  name         String
  photoUrl     String?
  active       Boolean @default(true)

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  workingHours WorkingHour[]
  appointments Appointment[]

  @@index([barbershopId])
  @@map("barbers")
}

model Service {
  id              Int     @id @default(autoincrement())
  barbershopId    Int
  name            String
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int
  active          Boolean @default(true)

  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([barbershopId])
  @@map("services")
}

model WorkingHour {
  id        Int    @id @default(autoincrement())
  barberId  Int
  weekday   Int    // 0 = domingo ... 6 = sábado
  startTime String // formato "09:00"
  endTime   String // formato "18:00"

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("working_hours")
}

model Appointment {
  id            Int               @id @default(autoincrement())
  barbershopId  Int
  barberId      Int
  serviceId     Int
  customerName  String
  customerPhone String
  startsAt      DateTime
  endsAt        DateTime
  status        AppointmentStatus @default(CONFIRMED)
  createdAt     DateTime          @default(now())

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber     Barber     @relation(fields: [barberId], references: [id])
  service    Service    @relation(fields: [serviceId], references: [id])

  @@index([barbershopId, startsAt])
  @@index([barberId, startsAt])
  @@map("appointments")
}